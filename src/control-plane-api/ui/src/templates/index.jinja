<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | default('Lablet Cloud Manager') }}</title>
    <link rel="icon" type="image/svg+xml" href="../assets/favicon.svg">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="../styles/main.scss">
    <script src="../scripts/main.js" type="module" defer></script>
</head>

<body>
    {# Feature flag: Use new tabbed navigation if enabled #}
    {% if use_tabbed_nav | default(true) %}
    {% include 'components/navbar_tabbed.jinja' %}
    {% else %}
    {% include 'components/navbar.jinja' %}
    {% endif %}

    <div class="container mt-4">
        {% include 'components/login.jinja' %}

        {# Overview section (placeholder for dashboard) #}
        <div id="overview-section" style="display: none">
            <div class="row mb-4">
                <div class="col">
                    <h2><i class="bi bi-speedometer2"></i> Overview</h2>
                    <p class="text-muted">Dashboard with system metrics - Coming soon</p>
                </div>
            </div>
        </div>

        {% include 'components/dashboard.jinja' %}
        {% include 'components/workers.jinja' %}

        {% include 'components/lablet_definitions.jinja' %}
        {% include 'components/lablet_instances.jinja' %}

        {% include 'components/system.jinja' %}
        {% include 'components/settings.jinja' %}

        {# Resource Scheduler section (F8: Scheduler Dashboard) #}
        <div id="scheduler-section" style="display: none"></div>

        {# Lab Records section (Phase 10: Labs Frontend) #}
        <div id="labs-section" style="display: none"></div>

        {# Sessions section (Phase 11: Sessions & LabletRecordRun UI) #}
        <div id="sessions-section" style="display: none"></div>
    </div>

    {% include 'components/modals.jinja' %}
    {% include 'components/worker_modals.jinja' %}
    {% include 'components/footer.jinja' %}
</body>

</html>
