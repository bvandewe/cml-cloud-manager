<!-- Lablet Definitions Dashboard Component -->
<div id="lablet-definitions-section" style="display: none">
    <!-- Web Components Container -->
    <div id="lablet-definitions-container">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col">
                <h2>
                    <i class="bi bi-file-earmark-code"></i> Lablet Definitions
                </h2>
                <p class="text-muted">
                    Manage lab templates and their resource requirements.
                </p>
            </div>
            <div class="col-auto">
                <div class="btn-group" role="group">
                    <button class="btn btn-primary admin-only-element" data-bs-toggle="modal"
                        data-bs-target="#createLabletDefinitionModal" style="display: none;">
                        <i class="bi bi-plus-circle"></i> New Definition
                    </button>
                    <button class="btn btn-outline-secondary" id="refresh-lablet-definitions-btn">
                        <i class="bi bi-arrow-clockwise"></i> Refresh
                    </button>
                </div>
            </div>
        </div>

        <!-- Lablet Definition List Component -->
        <lablet-definition-list></lablet-definition-list>
    </div>
</div>

<!-- Lablet Definition Details Modal -->
<div class="modal fade" id="labletDefinitionDetailsModal" tabindex="-1"
    aria-labelledby="labletDefinitionDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="labletDefinitionDetailsModalLabel">
                    <i class="bi bi-file-earmark-code"></i> Definition Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="labletDefinitionDetailsContent">
                <!-- Content loaded dynamically -->
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-primary d-none" id="syncDefinitionFromDetailBtn">
                    <i class="bi bi-arrow-repeat"></i> Synchronize
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Create Lablet Definition Modal -->
<div class="modal fade" id="createLabletDefinitionModal" tabindex="-1"
    aria-labelledby="createLabletDefinitionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createLabletDefinitionModalLabel">
                    <i class="bi bi-plus-circle"></i> Create Lablet Definition
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="createLabletDefinitionForm">
                    <div class="row">
                        <!-- Basic Info -->
                        <div class="col-md-6">
                            <h6 class="mb-3"><i class="bi bi-info-circle"></i> Basic Information</h6>

                            <div class="mb-3">
                                <label for="defName" class="form-label">Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="defName" required
                                    placeholder="e.g., cisco-netacad-lab-01" pattern="[a-z0-9-]+" minlength="3"
                                    maxlength="100">
                                <div class="form-text">Unique identifier (lowercase, no spaces).</div>
                            </div>

                            <div class="mb-3">
                                <label for="defVersion" class="form-label">Version <span
                                        class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="defVersion" required placeholder="1.0.0"
                                    pattern="[0-9]+\.[0-9]+\.[0-9]+" value="1.0.0">
                                <div class="form-text">Semantic version (e.g., 1.0.0).</div>
                            </div>

                            <div class="mb-3">
                                <label for="defFormQualifiedName" class="form-label">Form Qualified Name <span
                                        class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="defFormQualifiedName" required
                                    placeholder="e.g., Exam Associate CCNA v1.1 LAB 1.3a"
                                    minlength="3" maxlength="200">
                                <div class="form-text">Format: {trackType} {trackLevel} {trackAcronym} {examVersion} {moduleAcronym} {formName}</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Bucket Name (auto-derived)</label>
                                <div class="form-control bg-light font-monospace" id="defBucketNamePreview" style="min-height: 38px;">
                                    <span class="text-muted">Type a Form Qualified Name above...</span>
                                </div>
                                <div class="form-text">Auto-generated from the Form Qualified Name (lowercase, slugified).</div>
                            </div>
                        </div>

                        <!-- Lifecycle Settings + License -->
                        <div class="col-md-6">
                            <h6 class="mb-3"><i class="bi bi-clock"></i> Lifecycle Settings</h6>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="defMaxDuration" class="form-label">Max Duration (min)</label>
                                    <input type="number" class="form-control" id="defMaxDuration" min="1" max="480"
                                        value="60">
                                </div>
                                <div class="col-md-6">
                                    <label for="defWarmPoolDepth" class="form-label">Warm Pool Depth</label>
                                    <input type="number" class="form-control" id="defWarmPoolDepth" min="0" max="10"
                                        value="0">
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="defBootLeadTime" class="form-label">Boot Lead Time (min)</label>
                                    <input type="number" class="form-control" id="defBootLeadTime" min="0" max="120"
                                        placeholder="Global default">
                                    <div class="form-text">Minutes before session to start worker boot. Leave empty for global default.</div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">License Affinity</label>
                                <div class="d-flex gap-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="defLicensePersonal"
                                            value="personal">
                                        <label class="form-check-label" for="defLicensePersonal">Personal</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="defLicenseEnterprise"
                                            value="enterprise" checked>
                                        <label class="form-check-label" for="defLicenseEnterprise">Enterprise</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="defLicenseEvaluation"
                                            value="evaluation">
                                        <label class="form-check-label" for="defLicenseEvaluation">Evaluation</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Content Sync Settings -->
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <h6 class="mb-3"><i class="bi bi-cloud-download"></i> Content Sync Settings</h6>

                            <div class="mb-3">
                                <label for="defUserSessionPackageName" class="form-label">User Session Package</label>
                                <input type="text" class="form-control" id="defUserSessionPackageName"
                                    placeholder="SVN.zip" value="SVN.zip">
                                <div class="form-text">Package filename for the user session content.</div>
                            </div>

                            <div class="mb-3">
                                <label for="defGradingRulesetPackageName" class="form-label">Grading Ruleset Package</label>
                                <input type="text" class="form-control" id="defGradingRulesetPackageName"
                                    placeholder="SVN.zip" value="SVN.zip">
                                <div class="form-text">Package filename for the grading ruleset.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h6 class="mb-3">&nbsp;</h6>

                            <div class="mb-3">
                                <label for="defUserSessionType" class="form-label">User Session Type</label>
                                <select class="form-select" id="defUserSessionType">
                                    <option value="LDS" selected>LDS</option>
                                    <option value="CML">CML</option>
                                </select>
                                <div class="form-text">Type of user session environment.</div>
                            </div>

                            <div class="mb-3">
                                <label for="defUserSessionDefaultRegion" class="form-label">Default Region</label>
                                <input type="text" class="form-control" id="defUserSessionDefaultRegion"
                                    placeholder="e.g., us-east-1">
                                <div class="form-text">Default AWS region for user sessions (optional).</div>
                            </div>
                        </div>
                    </div>

                    <!-- Resource Specification (collapsible, full-width) -->
                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="border-top pt-3">
                                <!-- Toggle -->
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" role="switch"
                                           id="defResourceToggle">
                                    <label class="form-check-label" for="defResourceToggle">
                                        <i class="bi bi-cpu me-1"></i>
                                        <strong>Customize resource requirements</strong>
                                        <small class="text-muted d-block">
                                            Optional — safe defaults (2 CPU, 4 GB, 20 GB, 1 Node) are used automatically.
                                            Refine after first session observation.
                                        </small>
                                    </label>
                                </div>

                                <!-- Default hint (visible when collapsed) -->
                                <div id="resourceDefaultsHint" class="alert alert-light border py-2 px-3 small mt-2 mb-0">
                                    <i class="bi bi-info-circle text-primary me-1"></i>
                                    Defaults: <strong>2 CPU</strong>, <strong>4 GB RAM</strong>,
                                    <strong>20 GB Storage</strong>, <strong>1 Node</strong>,
                                    <strong>Nested Virt</strong>.
                                    Resources can be refined after the first session observation via
                                    <i class="bi bi-binoculars"></i> Observe.
                                </div>

                                <!-- Collapsed content -->
                                <div class="collapse mt-2" id="resourceRequirementsCollapse">
                                    <div class="border rounded p-3 bg-light">
                                        <div class="row mb-3">
                                            <div class="col-md-3">
                                                <label for="defCpuCores" class="form-label">CPU Cores</label>
                                                <input type="number" class="form-control" id="defCpuCores" min="1" max="64"
                                                    value="2">
                                            </div>
                                            <div class="col-md-3">
                                                <label for="defMemoryGb" class="form-label">Memory (GB)</label>
                                                <input type="number" class="form-control" id="defMemoryGb" min="1" max="256"
                                                    value="4">
                                            </div>
                                            <div class="col-md-3">
                                                <label for="defStorageGb" class="form-label">Storage (GB)</label>
                                                <input type="number" class="form-control" id="defStorageGb" min="1" max="1000"
                                                    value="20">
                                            </div>
                                            <div class="col-md-3">
                                                <label for="defNodeCount" class="form-label">Node Count</label>
                                                <input type="number" class="form-control" id="defNodeCount" min="1" max="50"
                                                    value="1">
                                            </div>
                                        </div>
                                        <div class="form-check mb-3">
                                            <input type="checkbox" class="form-check-input" id="defNestedVirt" checked>
                                            <label class="form-check-label" for="defNestedVirt">
                                                Requires Nested Virtualization
                                            </label>
                                        </div>
                                        <hr class="my-2">
                                        <h6 class="mb-2"><i class="bi bi-plug"></i> Port Definitions</h6>
                                        <div id="portDefinitionsContainer">
                                            <!-- Dynamic port definition rows -->
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                id="addPortDefinition">
                                            <i class="bi bi-plus"></i> Add Port
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="submitCreateLabletDefinition">
                    <i class="bi bi-plus-circle"></i> Create Definition
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Inline script for bucket name live preview -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Bucket name live preview
        const fqnInput = document.getElementById('defFormQualifiedName');
        const preview = document.getElementById('defBucketNamePreview');
        if (fqnInput && preview) {
            fqnInput.addEventListener('input', function() {
                const value = fqnInput.value.trim();
                if (!value) {
                    preview.innerHTML = '<span class="text-muted">Type a Form Qualified Name above...</span>';
                    return;
                }
                const slug = value
                    .toLowerCase()
                    .replace(/[^a-z0-9\s-]/g, '')
                    .replace(/\s+/g, '-')
                    .replace(/-+/g, '-')
                    .replace(/^-|-$/g, '');
                preview.textContent = slug || '—';
            });
        }

        // Resource requirements toggle
        const resourceToggle = document.getElementById('defResourceToggle');
        const collapseEl = document.getElementById('resourceRequirementsCollapse');
        const defaultsHint = document.getElementById('resourceDefaultsHint');

        if (resourceToggle && collapseEl) {
            const bsCollapse = new bootstrap.Collapse(collapseEl, { toggle: false });

            resourceToggle.addEventListener('change', function () {
                if (this.checked) {
                    bsCollapse.show();
                    if (defaultsHint) defaultsHint.style.display = 'none';
                } else {
                    bsCollapse.hide();
                    if (defaultsHint) defaultsHint.style.display = '';
                }
            });
        }
    });
</script>
