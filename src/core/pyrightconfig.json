{
    "include": ["."],
    "exclude": [".venv", "__pycache__", ".pytest_cache", ".ruff_cache"],
    "extraPaths": ["."],
    "pythonVersion": "3.11",
    "pythonPlatform": "All",
    "typeCheckingMode": "basic",
    "reportMissingImports": "warning",
    "reportMissingTypeStubs": "none",
    "venvPath": ".",
    "venv": ".venv"
}
