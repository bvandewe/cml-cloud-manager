{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://lcm.local/schemas/pav1/scenario.schema.json",
    "title": "PAv1 scenario.yaml",
    "description": "Content-defined SE scenario. Mirrors the jq-flavoured DSL implemented by application/services/dsl_executor.py. See docs/architecture/content-format/PAv1.md §4.4.",
    "type": "object",
    "additionalProperties": true,
    "required": ["name", "version", "do"],
    "properties": {
        "name": {
            "type": "string",
            "minLength": 1
        },
        "version": {
            "type": "string",
            "minLength": 1
        },
        "description": { "type": "string" },
        "do": {
            "description": "Ordered list of task objects. Each item is a single-key map; the key is the task name and the value is the task spec.",
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/named_task" }
        }
    },
    "$defs": {
        "named_task": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "patternProperties": {
                "^[a-zA-Z0-9_-]+$": { "$ref": "#/$defs/task_spec" }
            },
            "additionalProperties": false
        },
        "task_spec": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
                "call": { "type": "string", "minLength": 1 },
                "do": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/named_task" }
                },
                "set": { "type": "object" },
                "try": { "$ref": "#/$defs/task_spec" },
                "for": { "type": "object" },
                "fork": { "type": "object" },
                "switch": { "type": "object" },
                "wait": { "type": "object" },
                "emit": { "type": "object" },
                "run": { "type": "object" },
                "raise": { "type": "object" },
                "listen": { "type": "object" },
                "with": { "type": "object" },
                "input": { "type": "object" },
                "output": { "type": "object" },
                "export": { "type": "object" },
                "if": { "type": "string" },
                "timeout": {
                    "type": "object",
                    "properties": {
                        "seconds": { "type": "number", "exclusiveMinimum": 0 }
                    }
                },
                "retry": {
                    "type": "object",
                    "properties": {
                        "attempts": { "type": "integer", "minimum": 0 },
                        "backoff_seconds": { "type": "number", "minimum": 0 }
                    }
                },
                "then": { "type": "string" },
                "catch": { "type": "object" }
            },
            "anyOf": [
                { "required": ["call"] },
                { "required": ["do"] },
                { "required": ["set"] },
                { "required": ["try"] },
                { "required": ["for"] },
                { "required": ["fork"] },
                { "required": ["switch"] },
                { "required": ["wait"] },
                { "required": ["emit"] },
                { "required": ["run"] },
                { "required": ["raise"] },
                { "required": ["listen"] }
            ]
        }
    }
}
