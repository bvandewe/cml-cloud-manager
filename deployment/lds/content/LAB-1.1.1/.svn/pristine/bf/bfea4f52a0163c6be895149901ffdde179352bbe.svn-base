nodes:
  - boot_disk_size: null
    configuration:
      - name: ios_config.txt
        content: |-
          hostname rtr01
          no ip domain-lookup
          enable secret cisco
          !
          username admin privilege 15 secret cisco
          ip domain-name lab.local
          !
          crypto key generate rsa modulus 2048
          ip ssh version 2
          !
          interface GigabitEthernet0/0
           ip address 192.168.10.11 255.255.255.0
           no shutdown
          !
          interface GigabitEthernet0/1
           ip address 10.0.0.1 255.255.255.252
           no shutdown
          !
          line vty 0 4
           login local
           transport input ssh
    cpu_limit: null
    cpus: null
    data_volume: null
    hide_links: false
    id: n0
    image_definition: null
    label: rtr01
    node_definition: iosv
    parameters: {}
    ram: null
    tags:
      - serial:5045
    x: -280
    y: -160
    interfaces:
