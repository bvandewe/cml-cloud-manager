                        deactivate
                    ]]>
                </commands>
            </task> -->
            <task
                id="31"
                chunk="(cd /home/cisco/Desktop/tasks/; source venv/bin/activate ; ./ansible/run-playbook.sh ; deactivate ) \n"
                timeout="15"
                error="31.error.msg">
                workstation_serial::tExecute
            </task>
            <!-- <task
                id='31'
                patterns='remove_yes'> 
                workstation_serial::tExecuteBatch 
                <commands timeout='20'>
                    <![CDATA[
                        cd /home/cisco/Desktop/tasks/;
