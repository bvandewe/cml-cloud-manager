<rules id="LIBRARY">
    <config id="AWS">
        <action name="pre_collect">
            <!--  Wipe out all relevant devices (takes about 50 seconds) -->
            <task
                id="10"
                chunk="cmlctl --cml-password trackNMC50 --device-name rtr01,rtr02,sw01,sw02 --action wipe \n"
                timeout="120"
                error="10.error.msg">
                cmlctl-0::tExecute
            </task>

            <!--  Bounce interface Vl99 on sw01 and sw02 to ensure connectivity -->
            <task
                id="20"
                chunk="bounce_interface --interface-name Vl99 --device-prompt sw01 --serial-port 5048 \n"
                timeout="30"
                error="20.error.msg">
                cmlctl-0::tExecute
            </task>
            <task
                id="21"
                chunk="bounce_interface --interface-name Vl99 --device-prompt sw02 --serial-port 5049 \n"
                timeout="30"
                error="21.error.msg">
                cmlctl-0::tExecute
            </task>

            <!-- Execute Candidate solutions via console (activate/deactivate venv to leave prompt as default) -->
            <task
                id="30"
                chunk="(cd /home/cisco/Desktop/tasks/; source venv/bin/activate ; python ./scripts/py_deploy.py -i ./scripts/py_inventory.yaml ; deactivate ) \n"
                timeout="15"
                error="30.error.msg">
                workstation_serial::tExecute
            </task>
