{
    "_comment": "LCM Client Configuration for AIX Realm - Add these entries to aix-realm-export.json",
    "_instructions": ["1. Add the client-scopes to the 'clientScopes' array in aix-realm-export.json", "2. Add the clients to the 'clients' array in aix-realm-export.json", "3. Restart Keycloak or reimport the realm"],

    "clientScopes": [
        {
            "name": "lcm-audience",
            "description": "Adds LCM audience to access tokens",
            "protocol": "openid-connect",
            "attributes": {
                "include.in.token.scope": "true",
                "display.on.consent.screen": "false"
            },
            "protocolMappers": [
                {
                    "name": "lcm-audience-mapper",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-audience-mapper",
                    "consentRequired": false,
                    "config": {
                        "included.client.audience": "lcm",
                        "id.token.claim": "false",
                        "access.token.claim": "true",
                        "introspection.token.claim": "true"
                    }
                }
            ]
        }
    ],

    "clients": [
        {
            "clientId": "lcm-public",
            "name": "Lablet Cloud Manager Portal",
            "description": "Public client for LCM OAuth2 Authorization Code flow. Provides web interface for managing CML workers and labs.",
            "enabled": true,
            "publicClient": true,
            "protocol": "openid-connect",
            "redirectUris": ["http://localhost:8020/*", "http://localhost:8020/api/docs/oauth2-redirect", "http://localhost:8030/*", "http://localhost:8030/api/docs/oauth2-redirect", "https://admin.ciscolablets.com/*"],
            "webOrigins": ["http://localhost:8020", "http://localhost:8030", "https://admin.ciscolablets.com"],
            "standardFlowEnabled": true,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": true,
            "fullScopeAllowed": true,
            "defaultClientScopes": ["openid", "profile", "email", "roles", "lcm-audience", "events-player-audience"],
            "optionalClientScopes": [],
            "attributes": {
                "post.logout.redirect.uris": "http://localhost:8020",
                "pkce.code.challenge.method": "S256"
            },
            "protocolMappers": [
                {
                    "name": "realm-roles",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-usermodel-realm-role-mapper",
                    "consentRequired": false,
                    "config": {
                        "multivalued": "true",
                        "userinfo.token.claim": "true",
                        "id.token.claim": "true",
                        "access.token.claim": "true",
                        "claim.name": "roles",
                        "jsonType.label": "String"
                    }
                }
            ]
        },
        {
            "clientId": "lcm-backend",
            "name": "Lablet Cloud Manager Backend",
            "description": "Confidential backend client for LCM API. Used for token exchange and service-to-service communication.",
            "enabled": true,
            "publicClient": false,
            "secret": "lcm-backend-secret-change-in-production",
            "protocol": "openid-connect",
            "redirectUris": ["http://localhost:8020/*", "http://localhost:8020/api/docs/oauth2-redirect", "http://localhost:8030/*", "http://localhost:8030/api/docs/oauth2-redirect"],
            "webOrigins": ["http://localhost:8020", "http://localhost:8030"],
            "standardFlowEnabled": true,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": true,
            "serviceAccountsEnabled": true,
            "authorizationServicesEnabled": false,
            "fullScopeAllowed": true,
            "defaultClientScopes": ["openid", "profile", "email", "roles", "lcm-audience"],
            "optionalClientScopes": [],
            "protocolMappers": [
                {
                    "name": "realm-roles",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-usermodel-realm-role-mapper",
                    "consentRequired": false,
                    "config": {
                        "multivalued": "true",
                        "userinfo.token.claim": "true",
                        "id.token.claim": "true",
                        "access.token.claim": "true",
                        "claim.name": "roles",
                        "jsonType.label": "String"
                    }
                },
                {
                    "name": "username",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-usermodel-property-mapper",
                    "consentRequired": false,
                    "config": {
                        "userinfo.token.claim": "true",
                        "user.attribute": "username",
                        "id.token.claim": "true",
                        "access.token.claim": "true",
                        "claim.name": "preferred_username",
                        "jsonType.label": "String"
                    }
                },
                {
                    "name": "email",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-usermodel-property-mapper",
                    "consentRequired": false,
                    "config": {
                        "userinfo.token.claim": "true",
                        "user.attribute": "email",
                        "id.token.claim": "true",
                        "access.token.claim": "true",
                        "claim.name": "email",
                        "jsonType.label": "String"
                    }
                },
                {
                    "name": "full-name",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-full-name-mapper",
                    "consentRequired": false,
                    "config": {
                        "userinfo.token.claim": "true",
                        "id.token.claim": "true",
                        "access.token.claim": "true"
                    }
                }
            ]
        },
        {
            "clientId": "lcm-service",
            "name": "Lablet Cloud Manager Service Account",
            "description": "Service account client for LCM microservices (resource-scheduler, lablet-controller, worker-controller) to authenticate for inter-service communication.",
            "enabled": true,
            "publicClient": false,
            "secret": "lcm-service-secret-change-in-production",
            "protocol": "openid-connect",
            "redirectUris": [],
            "webOrigins": [],
            "standardFlowEnabled": false,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": true,
            "authorizationServicesEnabled": false,
            "fullScopeAllowed": true,
            "defaultClientScopes": ["openid", "profile", "email", "roles", "lcm-audience"],
            "optionalClientScopes": [],
            "protocolMappers": [
                {
                    "name": "realm-roles",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-usermodel-realm-role-mapper",
                    "consentRequired": false,
                    "config": {
                        "multivalued": "true",
                        "userinfo.token.claim": "true",
                        "id.token.claim": "true",
                        "access.token.claim": "true",
                        "claim.name": "roles",
                        "jsonType.label": "String"
                    }
                }
            ]
        }
    ]
}
