        "recommendations": ["ms-python.python", "ms-python.vscode-pylance", "charliermarsh.ruff", "ms-python.debugpy", "esbenp.prettier-vscode", "DavidAnson.vscode-markdownlint", "ms-azuretools.vscode-docker"],
