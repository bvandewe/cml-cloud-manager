<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<grading-rules xmlns='http://www.w3.org/2009/grading'>
    <lab title='R_200-901_LAB-2.5.1' version='LAB-2.5.1' reportClass='Reports::LabletReport'/>
    <!-- Section 0 : Concurrent Statements -->
     <section index='0' tag='invariant' description='INVARIANT' mode='concurrent' >
        <!-- Device: vmanage-mock - Concurrent Statements -->
         <subsection index='1' description='vmanage-mock' >
            <!-- Verification - Question - 0: Tasks - Output  1.1: Must see at least one successful response (status 200) on /j_security_check -->
                 <verify subject='commandOutput' device='vmanage-mock' command='mockctl --json search vmanage /j_security_check' match='/^(.*)$/msig' status='positive' out='search_j_security_check' timeout='3' suppressIssue='true'/>
             <!-- Verification - Question - 0: Tasks - Output  2.1: Must see at least one successful response (status 200) on /dataservice/client/token -->
                 <verify subject='commandOutput' device='vmanage-mock' command='mockctl --json search vmanage /dataservice/client/token' match='/^(.*)$/msig' status='positive' out='search_token' suppressIssue='true'/>
             <!-- Verification - Question - 0: Tasks - Output  3.1: Must see at least one successful response (status 200) on /dataservice/device/monitor -->
                 <verify subject='commandOutput' device='vmanage-mock' command='mockctl --json search vmanage /dataservice/device/monitor' match='/^(.*)$/msig' status='positive' out='search_devices' suppressIssue='true'/>
         </subsection>
    </section>
     <!-- Content -->
     <section index='1' points='8' description='Content'>
        <!-- Question - Check MFA step 1: Session cookie received from POST /j_security_check -->
         <subsection index='1' points='2' description='Check MFA step 1: Session cookie received from POST /j_security_check' domain='2.0 Understanding and Using APIs'>
                    <verify subject='parse' device='vmanage-mock' string='$(search_j_security_check)' regexp='/status_200.*\d*$/m' mode='positive' issue_replace='No successful response was found for /j_security_check endpoint'/>
        </subsection>
        <!-- Question - Check MFA step 2: CSRF Token -->
         <subsection index='2' points='3' description='Check MFA step 2: CSRF Token' domain='2.0 Understanding and Using APIs'>
                    <verify subject='parse' device='vmanage-mock' string='$(search_token)' regexp='/status_200.*\d*$/m' mode='positive' issue_replace='No successful request was seen on /dataservice/client/token'/>
        </subsection>
        <!-- Question - Check if the devices were ever successfully pulled -->
         <subsection index='3' points='3' description='Check if the devices were ever successfully pulled' domain='2.0 Understanding and Using APIs'>
                    <verify subject='parse' device='vmanage-mock' string='$(search_devices)' regexp='/status_200.*\d*$/m' mode='positive' issue_replace='No successful request was seen on /dataservice/device/monitor'/>
        </subsection>
    </section>
</grading-rules>
